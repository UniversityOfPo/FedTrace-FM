.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
secrets.json
secrets.yaml
secrets.yml
secrets.toml
.secrets/
credentials.json
credentials*.json
.claude/settings.local.json

