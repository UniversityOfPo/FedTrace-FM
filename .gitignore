# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# VS Code
.vscode/
*.code-workspace

# Jupyter
.ipynb_checkpoints/

# Datasets
data/*
!data/.gitkeep

# Checkpoints
checkpoints/*
!checkpoints/.gitkeep

# NDSS experiment checkpoints (E1-E4): large per-round/per-client model
# binaries (multiple GB total), never needed for reproducing FedTrace's
# forensic results -- only the recorded client_round_trace.csv /
# summary.json / round_history.csv artifacts under results_ndss/ are.
checkpoints_ndss/

# Experiment logs / results
logs/*
!logs/.gitkeep
results/*
!results/.gitkeep

# EXP_001-EXP_027 results: keep compact, paper-critical artifacts (summary.json,
# client_round_trace.csv, round_history.csv, multikrum_diagnostics.csv, metric
# CSV/JSON files) needed by scripts/generate_paper_{figures,tables}.py; exclude
# smoke runs, run logs, plots and regenerable partition-index dumps.
!results/federated/
!results/centralized/
!results/data_inspection/
results/**/*_smoke/
results/**/*.png
results/**/*.log
results/**/client_partition_indices.json

# NDSS experiment results (E1-E4): keep compact, paper-critical artifacts
# (client_round_trace.csv, summary.json, round_history.csv, the e{1,2,3,4}_*
# post-processing CSV/JSON/PNG outputs); exclude raw training run logs,
# regenerable partition-index dumps, and generic per-run training-curve
# plots that are not needed to reproduce the forensic detector results.
results_ndss/**/run.log
results_ndss/**/e1_wrapper_log.txt
results_ndss/**/client_partition_indices.json
results_ndss/**/communication_round_duration.png
results_ndss/**/confusion_matrix.png
results_ndss/**/local_training_loss.png
results_ndss/**/validation_loss.png
results_ndss/**/validation_top1.png
results_ndss/**/validation_top5.png

# Research database backups
Research_Database/backup/

